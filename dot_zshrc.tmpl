# ============================================================
# tmux workspace picker
# ============================================================

typeset -ga TM_PROJECT_ROOTS=(
  "$HOME/Projects"
  "$HOME/Developer"
  "$HOME/code"
  "$HOME/.config/nvim"
)


# ------------------------------------------------------------
# Discover Git projects from configured roots
# ------------------------------------------------------------

_tm_project_candidates() {
  local root marker project
  local -A seen

  for root in "${TM_PROJECT_ROOTS[@]}"; do
    [[ -e "$root" ]] || continue

    # The root itself may already be a Git repository.
    project="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)"

    if [[ -n "$project" ]]; then
      if [[ -z "${seen[$project]-}" ]]; then
        seen[$project]=1
        print -r -- "$project"
      fi
      continue
    fi

    # Otherwise discover repositories below it.
    while IFS= read -r marker; do
      marker="${marker%/}"
      project="${marker:h}"

      project="$(
        git -C "$project" rev-parse --show-toplevel 2>/dev/null
      )" || continue

      if [[ -z "${seen[$project]-}" ]]; then
        seen[$project]=1
        print -r -- "$project"
      fi
    done < <(
      {
        fd -H -t d -d 5 '^\.git$' "$root" 2>/dev/null
        fd -H -t f -d 5 '^\.git$' "$root" 2>/dev/null
      } | sort -u
    )
  done
}


# ------------------------------------------------------------
# Build unified workspace list
#
# Format:
#   TYPE<TAB>NAME<TAB>PATH<TAB>DISPLAY
# ------------------------------------------------------------

_tm_workspace_candidates() {
  local session workspace_path project current_root current_session label
  local -A seen_paths

  current_session=""
  if [[ -n "$TMUX" ]]; then
    current_session="$(tmux display-message -p '#S' 2>/dev/null)"
  fi

  # Existing tmux sessions
  while IFS= read -r session; do
    [[ -n "$session" ]] || continue

    workspace_path="$(
      tmux show-options \
        -t "=$session" \
        -qv @project_root 2>/dev/null
    )"

    if [[ -z "$workspace_path" ]]; then
      workspace_path="$(
        tmux display-message \
          -p \
          -t "=$session" \
          '#{pane_current_path}' 2>/dev/null
      )"
    fi

    [[ -n "$workspace_path" ]] || workspace_path="$HOME"

    seen_paths[$workspace_path]=1

    if [[ "$session" == "$current_session" ]]; then
      label="SESSION *"
    else
      label="SESSION"
    fi

    printf '%s\t%s\t%s\t%-10s %-24s %s\n' \
      "session" \
      "$session" \
      "$workspace_path" \
      "$label" \
      "$session" \
      "$workspace_path"

  done < <(
    tmux list-sessions -F '#{session_name}' 2>/dev/null
  )

  # Current directory / Git repository
  current_root="$(
    git -C "$PWD" rev-parse --show-toplevel 2>/dev/null ||
      pwd -P
  )"

  if [[ -n "$current_root" && -z "${seen_paths[$current_root]-}" ]]; then
    seen_paths[$current_root]=1

    printf '%s\t%s\t%s\t%-10s %-24s %s\n' \
      "project" \
      "$(basename "$current_root")" \
      "$current_root" \
      "CURRENT" \
      "$(basename "$current_root")" \
      "$current_root"
  fi

  # Discovered projects
  while IFS= read -r project; do
    [[ -n "$project" ]] || continue
    [[ -n "${seen_paths[$project]-}" ]] && continue

    seen_paths[$project]=1

    printf '%s\t%s\t%s\t%-10s %-24s %s\n' \
      "project" \
      "$(basename "$project")" \
      "$project" \
      "PROJECT" \
      "$(basename "$project")" \
      "$project"

  done < <(_tm_project_candidates)
}

# ------------------------------------------------------------
# Unified fzf picker
# ------------------------------------------------------------

_tm_pick_workspace() {
  local -a display_opts

  if [[ -n "$TM_PROJECT_POPUP" ]]; then
    display_opts=(
      --layout reverse
    )
  elif [[ -n "$TMUX" ]]; then
    display_opts=(
      --popup 'center,90%,78%,border-native'
    )
  else
    display_opts=(
      --height '75%'
      --layout reverse
      --border
    )
  fi

  _tm_workspace_candidates |
    fzf \
      "${display_opts[@]}" \
      --delimiter=$'\t' \
      --with-nth=4 \
      --prompt=' Workspace ❯ ' \
      --pointer='❯' \
      --header='SESSION: existing tmux   CURRENT: cwd   PROJECT: discovered repo' \
      --preview '
        kind={1}
        name={2}
        path={3}

        if [ "$kind" = "session" ]; then
          printf "tmux session\n────────────\n%s\n\n" "$name"

          printf "Windows\n───────\n"
          tmux list-windows \
            -t "=$name" \
            -F "#{window_index}: #{window_name}  [#{window_panes} panes]" \
            2>/dev/null

          printf "\nDirectory\n─────────\n%s\n" "$path"
        else
          printf "Project\n───────\n%s\n\n" "$path"

          printf "Git status\n──────────\n"
          git -C "$path" status --short --branch 2>/dev/null

          printf "\nRecent commits\n──────────────\n"
          git -C "$path" log -5 --oneline --decorate 2>/dev/null
        fi
      ' \
      --preview-window='right,50%,border-left'
}


# ------------------------------------------------------------
# Switch to existing tmux session
# ------------------------------------------------------------

_tm_switch_session() {
  local session="$1"

  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}


# ------------------------------------------------------------
# Open / create project session
# ------------------------------------------------------------

_tm_open_project() {
  local dir root session stored_root parent base candidate i

  dir="$1"

  if [[ ! -d "$dir" ]]; then
    echo "tm: not a directory: $dir" >&2
    return 1
  fi

  root="$(
    git -C "$dir" rev-parse --show-toplevel 2>/dev/null ||
      (cd "$dir" && pwd -P)
  )" || return 1

  base="$(basename "$root")"
  base="${base//[:. ]/_}"

  session="$base"


  # ----------------------------------------------------------
  # Find a safe session name
  # ----------------------------------------------------------

  if tmux has-session -t "=$session" 2>/dev/null; then
    stored_root="$(
      tmux show-options \
        -t "=$session" \
        -qv @project_root 2>/dev/null
    )"

    # Same project -> reuse it.
    if [[ -z "$stored_root" || "$stored_root" == "$root" ]]; then
      _tm_switch_session "$session"
      return
    fi

    # Same repo basename somewhere else.
    parent="$(basename "${root:h}")"
    candidate="${parent}-${base}"
    candidate="${candidate//[:. ]/_}"

    session="$candidate"
    i=2

    while tmux has-session -t "=$session" 2>/dev/null; do
      stored_root="$(
        tmux show-options \
          -t "=$session" \
          -qv @project_root 2>/dev/null
      )"

      if [[ "$stored_root" == "$root" ]]; then
        _tm_switch_session "$session"
        return
      fi

      session="${candidate}-${i}"
      (( i++ ))
    done
  fi


  # ----------------------------------------------------------
  # Create session
  # ----------------------------------------------------------

  tmux new-session \
    -d \
    -s "$session" \
    -c "$root"

  tmux set-option \
    -t "=$session" \
    @project_root "$root"

  _tm_switch_session "$session"
}


# ------------------------------------------------------------
# Public command
# ------------------------------------------------------------

tm() {
  local selection kind name workspace_path

  case "$#" in
    0)
      selection="$(_tm_pick_workspace)" || return
      [[ -n "$selection" ]] || return

      IFS=$'\t' read -r kind name workspace_path _ <<< "$selection"

      case "$kind" in
        session)
          _tm_switch_session "$name"
          ;;

        project)
          _tm_open_project "$workspace_path"
          ;;

        *)
          echo "tm: unknown workspace type: $kind" >&2
          return 1
          ;;
      esac
      ;;

    1)
      _tm_open_project "$1"
      ;;

    *)
      echo "usage: tm [directory]" >&2
      return 2
      ;;
  esac
}
